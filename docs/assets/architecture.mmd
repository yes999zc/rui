%% rui — layered architecture, vertical (source for docs/assets/architecture.svg / .png)
%% palette: ink #1f2a2e, teal #2f6f6a, sand #e8e2d6, accent #b4744a
%%{init: {'themeVariables': {'fontSize': '16px', 'fontFamily': 'Helvetica Neue, Arial, sans-serif'}, 'flowchart': {'htmlLabels': false, 'curve': 'basis', 'nodeSpacing': 40, 'rankSpacing': 60}}}%%
flowchart LR
  classDef svc fill:#e8e2d6,stroke:#2f6f6a,stroke-width:2px,color:#1f2a2e
  classDef plane fill:#f4efe6,stroke:#b4744a,stroke-width:2px,color:#1f2a2e
  classDef dev fill:#ffffff,stroke:#1f2a2e,stroke-width:2px,color:#1f2a2e
  classDef store fill:#f7f5f0,stroke:#8a8580,stroke-dasharray:5 4,color:#1f2a2e

  subgraph SERVER["1 · Server"]
    direction LR
    S1["Session / turn"]:::svc
    S2["Providers<br/>LLM TTS ASR"]:::svc
    S3["Wake arbiter"]:::svc
    S4["Console API"]:::svc
  end

  subgraph PLANE["2 · Audio plane"]
    direction LR
    P1["KWS/VAD gate"]:::plane
    P2["ASR feed"]:::plane
    P3["Playback queue"]:::plane
  end

  subgraph DEV["3 · Devices"]
    direction LR
    D1["dot2 bridge"]:::dev
    D2["xiaoai bridge"]:::dev
    D3["speaker<br/>mic playback LED"]:::dev
  end

  CFG[("config<br/>secrets")]:::store

  CFG -.-> SERVER
  SERVER -->|"admit · speak · stop"| PLANE
  PLANE -->|"downlink"| DEV
  DEV -->|"uplink"| PLANE
