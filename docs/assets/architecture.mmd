%% rui — layered architecture (source for docs/assets/architecture.svg / .png)
%% palette: ink #1f2a2e, teal #2f6f6a, sand #e8e2d6, accent #b4744a
flowchart LR
  classDef svc fill:#e8e2d6,stroke:#2f6f6a,stroke-width:1.5px,color:#1f2a2e
  classDef plane fill:#f4efe6,stroke:#b4744a,stroke-width:1.5px,color:#1f2a2e
  classDef dev fill:#ffffff,stroke:#1f2a2e,stroke-width:1.5px,color:#1f2a2e
  classDef store fill:#f7f5f0,stroke:#8a8580,stroke-dasharray:4 3,color:#1f2a2e

  subgraph S["Server · control plane (FastAPI)"]
    direction TB
    T["session / turn<br/>dialog + tools"]:::svc
    P["providers<br/>LLM · TTS · ASR"]:::svc
    A["wake arbiter<br/>one turn per room"]:::svc
    W["console v2 API<br/>/api/v2 · /v2"]:::svc
    M[("config.yaml<br/>+ secrets.yaml")]:::store
  end

  subgraph B["Audio plane · one process per device"]
    direction TB
    K["KWS / VAD gate<br/>preroll · echo excision"]:::plane
    F["ASR feed<br/>16 kHz mono"]:::plane
    O["playback queue<br/>music · replies · ack cue"]:::plane
  end

  subgraph D["Devices · plug adapters"]
    direction TB
    X["dot2 bridge<br/>rui-device/v1"]:::dev
    Y["xiaoai bridge<br/>rui-device/v1"]:::dev
    Z["speaker<br/>mic + playback + LED"]:::dev
  end

  Z -->|"audio uplink"| X
  Z -->|"audio uplink"| Y
  X -->|"wake candidate / utterance"| K
  Y -->|"wake candidate / utterance"| K
  K --> F --> P
  A -->|"admit / reject"| K
  T --> P
  P -->|"reply pcm"| O
  O -->|"downlink"| X
  O -->|"downlink"| Y
  M --- T
  W --- A
  W --- M
