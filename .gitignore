__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
node_modules/
web/dist/
data/
# ...but package data ships with the wheel: the joke tool's samples live under
# src/rui/data/. `data/` above matches that directory too, and both a clean checkout
# and hatchling obey this file, so it must be re-included explicitly (dir first).
!src/rui/data/
!src/rui/data/*.json
*.log
.DS_Store
.env

# Audit/polish screenshots can contain real LAN addresses, dialog text and
# personal paths; keep them local unless a sanitized set is explicitly chosen.
docs/console-shots/ux2-*.png
docs/console-shots/providers-v2*.png
docs/console-shots/polish-*.png
docs/console-shots/mcp-v2*.png

docs/console-shots/brand-*.png

# Guided acceptance output (docs/acceptance.md). May name the deployment; keep local.
acceptance-runs/

# Local output of scripts/security-pip-audit.sh; CI uploads it as an artifact.
security-reports/

# Coverage/test artifacts from the 0.7.3 baseline workflow (scripts/coverage_report.py).
.coverage
.coverage.*
coverage.json
pytest-report.xml
python-version.txt
